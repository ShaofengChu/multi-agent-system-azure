# ==============================================================================
# Azure OpenAI 設定（Phase 1: kongctl apply / Phase 2: Agent 起動時に使用）
# ==============================================================================
# Azure OpenAI リソース名（https://<INSTANCE>.openai.azure.com/ の <INSTANCE> 部分）
AZURE_OPENAI_INSTANCE="<your-azure-openai-instance>"
AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5-mini"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# ==============================================================================
# Kong Konnect / kongctl 設定（Phase 1 で使用）
# ==============================================================================
# Phase 1-1 で新規作成した AI Gateway Control Plane の名前
KONNECT_CONTROL_PLANE_NAME="local-poc-ai-gateway-pc2"
# `kongctl login` の代わりに PAT を使う場合に設定（default プロファイル用）
# KONGCTL_DEFAULT_KONNECT_PAT="<your-konnect-pat>"

# ==============================================================================
# Docker Compose 設定（Phase 2 で使用）
# ==============================================================================
# Kong Data Plane コンテナ名（--name kong-gateway で起動する場合はそのまま）
KONG_GATEWAY_URL="http://kong-gateway:8000"
# direct 疎通用の main-agent ホスト側ポート（通常は Kong の 8000 番経由でアクセス）
MAIN_AGENT_PORT="8008"
